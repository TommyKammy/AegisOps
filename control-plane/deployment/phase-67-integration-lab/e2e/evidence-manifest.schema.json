                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": [
                      "service",
                      "immutable_reference"
                    ],
                    "properties": {
                      "service": {
                        "const": "shuffle-orborus"
                      },
                      "immutable_reference": {
                        "const": "ghcr.io/shuffle/shuffle-orborus:2.2.1@sha256:3519810b3ca4fe568acefdf15ce6f2deba0ae6f0ff6b84412354d59d663dff31"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": [
                      "service",
                      "immutable_reference"
                    ],
                    "properties": {
                      "service": {
                        "const": "wazuh-dashboard"
                      },
                      "immutable_reference": {
                        "const": "wazuh/wazuh-dashboard:4.14.6@sha256:16aa978eaa6355fe3965e310ef8eaaed4df6f701dcf5885ebd0783fcd5ee6f16"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": [
                      "service",
                      "immutable_reference"
                    ],
                    "properties": {
                      "service": {
                        "const": "wazuh-indexer"
                      },
                      "immutable_reference": {
                        "const": "wazuh/wazuh-indexer:4.14.6@sha256:27261711c6479e2e503171918aae9a23b3fc4dcfc2d28d204e75985c1e0fb4c5"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": [
                      "service",
                      "immutable_reference"
                    ],
                    "properties": {
                      "service": {
                        "const": "wazuh-manager"
                      },
                      "immutable_reference": {
                        "const": "wazuh/wazuh-manager:4.14.6@sha256:4683ddc88474c79ae6171d9132adbd45fda86bdfb22ad0d8ddee167654c9e841"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        }
      }
    },
    "current_image_inventory": {
      "type": "object",
