# Phase 67.1 non-production Colima integration-lab defaults.
# init.sh writes an untracked runtime.env with generated secret values.

AEGISOPS_LAB_COLIMA_PROFILE=mac-studio-solo
AEGISOPS_LAB_DOCKER_CONTEXT=colima-mac-studio-solo
AEGISOPS_LAB_COMPOSE_PROJECT_NAME=aegisops-phase67-lab
AEGISOPS_LAB_RUNTIME_ROOT=${HOME}/.local/share/aegisops/phase-67-integration-lab
AEGISOPS_LAB_NETWORK_SUBNET=172.31.67.0/24
AEGISOPS_LAB_PROXY_IPV4=172.31.67.10
AEGISOPS_LAB_CONTROL_PLANE_IPV4=172.31.67.20
AEGISOPS_LAB_POSTGRES_IPV4=172.31.67.30
AEGISOPS_LAB_WAZUH_MANAGER_IPV4=172.31.67.40
AEGISOPS_LAB_WAZUH_INDEXER_IPV4=172.31.67.41
AEGISOPS_LAB_WAZUH_DASHBOARD_IPV4=172.31.67.42
AEGISOPS_LAB_SHUFFLE_BACKEND_IPV4=172.31.67.50
AEGISOPS_LAB_SHUFFLE_OPENSEARCH_IPV4=172.31.67.51
AEGISOPS_LAB_SHUFFLE_FRONTEND_IPV4=172.31.67.52

AEGISOPS_LAB_PROXY_PORT=18443
AEGISOPS_LAB_WAZUH_DASHBOARD_PORT=18444
AEGISOPS_LAB_SHUFFLE_FRONTEND_PORT=13001

AEGISOPS_LAB_MIN_CPUS=8
AEGISOPS_LAB_MIN_MEMORY_GIB=16
AEGISOPS_LAB_MIN_DISK_GIB=100

AEGISOPS_LAB_WAZUH_PLATFORM=linux/arm64
AEGISOPS_LAB_SHUFFLE_PLATFORM=linux/amd64
AEGISOPS_LAB_ALLOW_EMULATION=yes

AEGISOPS_LAB_WAZUH_VERSION=4.14.6
AEGISOPS_LAB_WAZUH_DOCKER_COMMIT=499184cbeb44fc1086791d11ad4b9bdcb77a9bb9
AEGISOPS_LAB_SHUFFLE_VERSION=2.2.1
