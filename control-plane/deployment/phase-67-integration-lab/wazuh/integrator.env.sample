# Phase 67.2 reviewed non-secret Wazuh Integrator bindings.
# docker-compose.yml supplies these values to the isolated manager container.
# The bearer value is never stored here; it is read from the mounted file.

AEGISOPS_WAZUH_INGEST_URL=https://proxy:8443/intake/wazuh
AEGISOPS_WAZUH_INGEST_SHARED_SECRET_FILE=/run/secrets/wazuh-ingest-shared-secret
AEGISOPS_WAZUH_INGEST_CA_FILE=/var/ossec/integrations/aegisops-lab-ca.crt
AEGISOPS_WAZUH_ALLOWED_RULE_ID=5710
AEGISOPS_WAZUH_RECEIPT_FILE=/var/ossec/logs/integrations/aegisops-receipts.jsonl
AEGISOPS_WAZUH_HTTP_TIMEOUT_SECONDS=10
